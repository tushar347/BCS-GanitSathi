    "target_quantity": "probability of A union B",
    "english_glossary": {
      "স্বাধীন": "independent"
    },
    "question_bn": "P(A) = 1/3, P(B) = 3/4, A ও B স্বাধীন হলে P(A ∪ B)-এর মান কত?",
    "answer_options": [
      "3/21",
      "1/3",
      "5/6",
      "এর কোনটিই নয়"
    ],
    "correct_answer": "5/6",
    "solution_steps": [
      "Independence gives P(A∩B)=(1/3)(3/4)=1/4.",
      "P(A∪B)=P(A)+P(B)−P(A∩B).",
      "Therefore 1/3+3/4−1/4=1/3+1/2=5/6."
    ]
  }
